{
  "manifest_version": 3,
  "name": "Orvpass Autofill",
  "version": "2.0.0",
  "description": "Premium autofill extension for Orvpass",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
